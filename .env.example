# Copy to .env.local for local development; set the same names in
# Vercel → Project → Settings → Environment Variables. Never commit real keys.

# Public site URL used for canonical links, Open Graph, sitemap and robots.
# Optional: without it, Vercel's production domain is used (then the deployment URL).
# Set it once you have a custom domain, e.g. https://shreekolape.com
NEXT_PUBLIC_SITE_URL=

# Contact form, sent through Resend. Step-by-step setup: CONTACT_SETUP.md.
# Without RESEND_API_KEY and CONTACT_TO_EMAIL the form shows its fallback
# message ("please email me instead") and the server logs why.
RESEND_API_KEY=
# Where enquiries arrive. With the default sender below, this must be the
# email address of your Resend account.
CONTACT_TO_EMAIL=
# Optional. Defaults to "Portfolio <onboarding@resend.dev>", which works without
# a custom domain. Once you verify a domain in Resend, use e.g. "Portfolio <hello@yourdomain.com>".
CONTACT_FROM_EMAIL=
