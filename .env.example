# Copy to .env.local for local development; set the same names in
# Vercel → Project → Settings → Environment Variables. Never commit real keys.

# Public site URL used for canonical links, Open Graph, sitemap and robots.
# Optional on Vercel (falls back to the production URL); set it once you have a custom domain.
NEXT_PUBLIC_SITE_URL=

# Contact form email provider (see app/api/contact/route.ts). Until all three are
# set, the form shows its error message and asks people to email instead.
CONTACT_PROVIDER_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
